{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "incremental": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // `yugen-ui/dates` (#356) and `yugen-ui/form` (#162) live outside the root barrel.
  "include": ["src/lib.ts", "src/components/ui/dates.ts", "src/components/ui/HookForm/HookForm.tsx"]
}
