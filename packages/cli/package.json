{
  "name": "@yugen-ui/cli",
  "version": "0.7.0",
  "description": "CLI for Yugen UI: create an app from a template, set up Yugen UI in an existing project, add component source from the registry and diagnose the setup.",
  "keywords": [
    "yugen-ui",
    "cli",
    "react",
    "tailwindcss",
    "components",
    "registry",
    "templates",
    "scaffold"
  ],
  "license": "MIT",
  "author": {
    "name": "trandat1114",
    "url": "https://github.com/trandat1114"
  },
  "homepage": "https://trandat1114.github.io/Yugen-UI/concepts/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trandat1114/Yugen-UI.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/trandat1114/Yugen-UI/issues"
  },
  "type": "module",
  "bin": {
    "yugen": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/copy-templates.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:release": "node scripts/check-release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
