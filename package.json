{
  "name": "yugen-ui",
  "version": "0.8.3",
  "description": "Fluent 2-inspired React component library for Tailwind CSS v4: design tokens, accessible Radix-based components, Sakura brand, light/dark/high-contrast themes and RTL.",
  "keywords": [
    "react",
    "components",
    "component-library",
    "ui",
    "design-system",
    "design-tokens",
    "fluent",
    "fluent-2",
    "tailwindcss",
    "tailwindcss-v4",
    "radix-ui",
    "shadcn",
    "accessibility",
    "a11y",
    "rtl",
    "dark-mode",
    "high-contrast",
    "typescript",
    "sakura"
  ],
  "license": "MIT",
  "author": {
    "name": "trandat1114",
    "url": "https://github.com/trandat1114"
  },
  "homepage": "https://trandat1114.github.io/Yugen-UI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trandat1114/Yugen-UI.git"
  },
  "bugs": {
    "url": "https://github.com/trandat1114/Yugen-UI/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/lib.js",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "registry": "node scripts/build-registry.mjs",
    "cli": "npm run build --prefix packages/cli && node packages/cli/dist/index.js",
    "build:docs": "npm run registry && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json && node scripts/build-css.mjs",
    "build": "npm run build:lib && npm run build:docs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint:classes": "node scripts/canonical-classes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "size": "size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-templates.mjs && npm install --package-lock-only",
    "check:release": "node scripts/check-release.mjs",
    "check:examples": "vite-node scripts/check-examples.ts",
    "check:props": "vite-node scripts/check-props.ts",
    "roadmap": "vite-node scripts/sync-roadmap.ts",
    "prepublishOnly": "npm run check:release && npm run typecheck && npm run lint:classes && npm run build:lib",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.264",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.7",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/esbuild": "^14.2.0",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.0.0",
    "tsc-alias": "^1.9.8",
    "typescript": "^6.0.3",
    "vite": "^6.0.11",
    "vite-node": "^3.2.4",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  }
}
